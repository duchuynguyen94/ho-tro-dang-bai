{
  "site": "ngochuyduong.com",
  "version": 1,
  "steps": [
    {
      "action": "type",
      "note": "AI tiêu đề → Tên sản phẩm",
      "selector": "#title",
      "selectors": [
        "#title",
        "input[name='post_title']"
      ],
      "value": "{{title}}",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Ô Mô tả ngắn → chuyển sang chế độ Mã (để điền chắc hơn)",
      "selector": "#excerpt-html",
      "selectors": [
        "#excerpt-html"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "type",
      "note": "AI description → Mô tả ngắn của sản phẩm",
      "selector": "#excerpt",
      "selectors": [
        "#excerpt",
        "textarea[name='excerpt']"
      ],
      "value": "{{description}}",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Ô Mô tả ngắn → về Trực quan",
      "selector": "#excerpt-tmce",
      "selectors": [
        "#excerpt-tmce"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "click",
      "note": "Ô Mô tả sản phẩm → chuyển sang chế độ Mã (để dán HTML)",
      "selector": "#content-html",
      "selectors": [
        "#content-html",
        ".wp-switch-editor:has-text('Mã')"
      ],
      "value": "",
      "source": "auto"
    },
    {
      "action": "type",
      "note": "AI content (HTML) → Mô tả sản phẩm",
      "selector": "#content",
      "selectors": [
        "#content",
        "textarea[name='content']"
      ],
      "value": "{{content_html}}",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Ô Mô tả sản phẩm → về Trực quan (xem lại dạng thật)",
      "selector": "#content-tmce",
      "selectors": [
        "#content-tmce",
        ".wp-switch-editor:has-text('Trực quan')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "wait",
      "note": "Chờ giao diện ổn định",
      "selector": "",
      "selectors": [],
      "value": "1",
      "source": "auto"
    },
    {
      "action": "open_panel",
      "note": "Mở card Rank Math SEO (nếu đang thu gọn)",
      "selector": "#rank_math_metabox .handlediv",
      "selectors": [
        "#rank_math_metabox .handlediv",
        "#rank_math_metabox button.handlediv",
        "#rank_math_metabox h2",
        "#rank_math_metabox .hndle"
      ],
      "value": "input[placeholder='Ví dụ: Rank Math SEO']",
      "source": "auto",
      "optional": true
    },
    {
      "action": "type",
      "note": "AI focus keyword → Từ khoá chính (Rank Math)",
      "selector": "input[placeholder='Ví dụ: Rank Math SEO']",
      "selectors": [
        "input[placeholder='Ví dụ: Rank Math SEO']",
        "#rank_math_metabox input[placeholder*='Rank Math SEO']",
        "#rank_math_metabox input[type='text']"
      ],
      "value": "{{focus_keyword}}",
      "source": "auto"
    },
    {
      "action": "type",
      "note": "AI search tags → Thẻ sản phẩm",
      "selector": "#newproduct_tag",
      "selectors": [
        "#newproduct_tag",
        "textarea[name='newproduct_tag']",
        "#tagsdiv-product_tag textarea",
        "#tagsdiv-product_tag input[type='text']"
      ],
      "value": "{{tags}}",
      "source": "auto",
      "optional": true
    },
    {
      "action": "click",
      "note": "Bấm “Thêm” để thêm thẻ sản phẩm",
      "selector": "#tagsdiv-product_tag .tagadd",
      "selectors": [
        "#tagsdiv-product_tag .tagadd",
        "#product_tag-add-submit",
        "#tagsdiv-product_tag input[type='button']",
        "#tagsdiv-product_tag button:has-text('Thêm')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "click",
      "note": "AI hình 1 → bấm “Đặt ảnh sản phẩm”",
      "selector": "#set-post-thumbnail",
      "selectors": [
        "#set-post-thumbnail",
        "a:has-text('Đặt ảnh sản phẩm')"
      ],
      "value": "",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Chọn tab “Tải lên tệp mới”",
      "selector": "#menu-item-upload",
      "selectors": [
        "#menu-item-upload",
        ".media-menu-item:has-text('Tải lên tệp mới')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "upload",
      "note": "Tải ảnh 1 lên",
      "selector": ".media-modal input[type='file']",
      "selectors": [
        ".media-modal input[type='file']",
        "input[type='file']"
      ],
      "value": "{{image_1}}",
      "source": "auto"
    },
    {
      "action": "wait",
      "note": "Chờ ảnh tải lên xong",
      "selector": "",
      "selectors": [],
      "value": "4",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Đặt làm ảnh sản phẩm",
      "selector": ".media-toolbar-primary button",
      "selectors": [
        ".media-toolbar-primary button",
        "button.media-button-select",
        "button:has-text('Đặt ảnh sản phẩm')"
      ],
      "value": "",
      "source": "auto"
    },
    {
      "action": "wait",
      "note": "Chờ hộp ảnh đóng",
      "selector": "",
      "selectors": [],
      "value": "2",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "AI hình 2+ → bấm “Thêm ảnh thư viện sản phẩm”",
      "selector": ".add_product_images a",
      "selectors": [
        ".add_product_images a",
        "a:has-text('Thêm ảnh thư viện sản phẩm')",
        "#product_images_container a.add_product_images"
      ],
      "value": "",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Chọn tab “Tải lên tệp mới” (thư viện)",
      "selector": "#menu-item-upload",
      "selectors": [
        "#menu-item-upload",
        ".media-menu-item:has-text('Tải lên tệp mới')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "upload",
      "note": "Tải các ảnh còn lại lên (ảnh 2,3,4,5,6…)",
      "selector": ".media-modal input[type='file']",
      "selectors": [
        ".media-modal input[type='file']",
        "input[type='file']"
      ],
      "value": "{{image_2}}|{{image_3}}|{{image_4}}|{{image_5}}|{{image_6}}",
      "source": "auto"
    },
    {
      "action": "wait",
      "note": "Chờ ảnh tải lên xong",
      "selector": "",
      "selectors": [],
      "value": "5",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Thêm vào thư viện ảnh sản phẩm",
      "selector": ".media-toolbar-primary button",
      "selectors": [
        ".media-toolbar-primary button",
        "button.media-button-select",
        "button:has-text('Thêm vào thư viện')"
      ],
      "value": "",
      "source": "auto"
    }
  ]
}