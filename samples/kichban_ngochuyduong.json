{
  "site": "ngochuyduong.com",
  "version": 1,
  "steps": [
    {
      "action": "type",
      "note": "AI tiêu đề → Tên sản phẩm",
      "selector": "#title",
      "selectors": [
        "#title",
        "input[name='post_title']"
      ],
      "value": "{{title}}",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Ô Mô tả ngắn → chuyển sang chế độ Mã (để điền chắc hơn)",
      "selector": "#excerpt-html",
      "selectors": [
        "#excerpt-html"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "type",
      "note": "AI description → Mô tả ngắn của sản phẩm",
      "selector": "#excerpt",
      "selectors": [
        "#excerpt",
        "textarea[name='excerpt']"
      ],
      "value": "{{description}}",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Ô Mô tả ngắn → về Trực quan",
      "selector": "#excerpt-tmce",
      "selectors": [
        "#excerpt-tmce"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "click",
      "note": "Ô Mô tả sản phẩm → chuyển sang chế độ Mã (để dán HTML)",
      "selector": "#content-html",
      "selectors": [
        "#content-html",
        ".wp-switch-editor:has-text('Mã')"
      ],
      "value": "",
      "source": "auto"
    },
    {
      "action": "type",
      "note": "AI content (HTML) → Mô tả sản phẩm",
      "selector": "#content",
      "selectors": [
        "#content",
        "textarea[name='content']"
      ],
      "value": "{{content_html}}",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Ô Mô tả sản phẩm → về Trực quan (xem lại dạng thật)",
      "selector": "#content-tmce",
      "selectors": [
        "#content-tmce",
        ".wp-switch-editor:has-text('Trực quan')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "wait",
      "note": "Chờ giao diện ổn định",
      "selector": "",
      "selectors": [],
      "value": "1",
      "source": "auto"
    },
    {
      "action": "open_panel",
      "note": "Mở card Rank Math SEO (nếu đang thu gọn)",
      "selector": "#rank_math_metabox .handlediv",
      "selectors": [
        "#rank_math_metabox .handlediv",
        "#rank_math_metabox button.handlediv",
        "#rank_math_metabox h2",
        "#rank_math_metabox .hndle"
      ],
      "value": "input[placeholder='Ví dụ: Rank Math SEO']",
      "source": "auto",
      "optional": true
    },
    {
      "action": "tagify",
      "note": "AI focus keyword → Từ khoá chính (Rank Math)",
      "selector": ".rank-math-focus-keyword .tagify__input",
      "selectors": [
        "#rank_math_metabox .rank-math-focus-keyword .tagify__input",
        ".rank-math-focus-keyword .tagify__input",
        "#rank_math_metabox .tagify__input",
        ".tagify__input"
      ],
      "value": "{{focus_keyword}}",
      "source": "auto"
    },
    {
      "action": "type",
      "note": "AI search tags → Thẻ sản phẩm",
      "selector": "#new-tag-product_tag",
      "selectors": [
        "#new-tag-product_tag",
        "#tagsdiv-product_tag input.newtag",
        "#tagsdiv-product_tag input[type='text']",
        "#tax-input-product_tag"
      ],
      "value": "{{tags}}",
      "source": "auto",
      "optional": true
    },
    {
      "action": "click",
      "note": "Bấm “Thêm” để thêm thẻ sản phẩm",
      "selector": "#tagsdiv-product_tag .tagadd",
      "selectors": [
        "#tagsdiv-product_tag .tagadd",
        "#tagsdiv-product_tag input.tagadd",
        "#tagsdiv-product_tag input[type='button']"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "press",
      "note": "Rời ô tiêu đề để WP tạo đường dẫn",
      "selector": "#title",
      "selectors": [
        "#title"
      ],
      "value": "Tab",
      "source": "auto",
      "optional": true
    },
    {
      "action": "wait",
      "note": "Chờ WP sinh đường dẫn",
      "selector": "",
      "selectors": [],
      "value": "2",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Bấm “Chỉnh sửa” cạnh đường dẫn",
      "selector": "#edit-slug-buttons .edit-slug",
      "selectors": [
        "#edit-slug-buttons .edit-slug",
        "#edit-slug-box .edit-slug",
        "button.edit-slug",
        "button:has-text('Chỉnh sửa')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "type",
      "note": "Điền đường dẫn (slug) từ tiêu đề — dưới 60 ký tự",
      "selector": "#new-post-slug",
      "selectors": [
        "#new-post-slug",
        "#edit-slug-box input[type='text']"
      ],
      "value": "{{slug}}",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Bấm “Đồng ý” để chốt đường dẫn (BẮT BUỘC)",
      "selector": "#edit-slug-buttons .save",
      "selectors": [
        "#edit-slug-buttons .save",
        "#edit-slug-box .save",
        "button.save",
        "button:has-text('Đồng ý')"
      ],
      "value": "",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "AI hình 1 → bấm “Đặt ảnh sản phẩm”",
      "selector": "#set-post-thumbnail",
      "selectors": [
        "#set-post-thumbnail",
        "a:has-text('Đặt ảnh sản phẩm')"
      ],
      "value": "",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Chọn tab “Tải lên tệp mới”",
      "selector": "#menu-item-upload",
      "selectors": [
        "#menu-item-upload",
        ".media-menu-item:has-text('Tải lên tệp mới')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "upload",
      "note": "Tải ảnh 1 lên",
      "selector": ".media-modal input[type='file']",
      "selectors": [
        ".media-modal input[type='file']",
        "input[type='file']"
      ],
      "value": "{{image_1}}",
      "source": "auto"
    },
    {
      "action": "wait",
      "note": "Chờ ảnh tải lên xong",
      "selector": "",
      "selectors": [],
      "value": "4",
      "source": "auto"
    },
    {
      "action": "fill_attachment",
      "note": "Điền 4 ô ảnh 1 (Tiêu đề/SEO/Caption/Miêu tả) ← TÊN ẢNH 1",
      "selector": "",
      "selectors": [],
      "value": "{{image_name_1}}",
      "source": "auto",
      "optional": true
    },
    {
      "action": "click",
      "note": "Đặt làm ảnh sản phẩm",
      "selector": "button.media-button-select",
      "selectors": [
        "button.media-button-select",
        ".media-toolbar-primary .media-button-select",
        "button:has-text('Đặt ảnh sản phẩm')",
        "button:has-text('Thêm vào thư viện')"
      ],
      "value": "",
      "source": "auto"
    },
    {
      "action": "wait",
      "note": "Chờ hộp ảnh đóng",
      "selector": "",
      "selectors": [],
      "value": "2",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "AI hình 2+ → bấm “Thêm ảnh thư viện sản phẩm”",
      "selector": ".add_product_images a",
      "selectors": [
        ".add_product_images a",
        "a:has-text('Thêm ảnh thư viện sản phẩm')",
        "#product_images_container a.add_product_images"
      ],
      "value": "",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Chọn tab “Tải lên tệp mới” (thư viện)",
      "selector": "#menu-item-upload",
      "selectors": [
        "#menu-item-upload",
        ".media-menu-item:has-text('Tải lên tệp mới')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "upload",
      "note": "Tải các ảnh còn lại lên (ảnh 2,3,4,5,6…)",
      "selector": ".media-modal input[type='file']",
      "selectors": [
        ".media-modal input[type='file']",
        "input[type='file']"
      ],
      "value": "{{image_2}}|{{image_3}}|{{image_4}}|{{image_5}}|{{image_6}}",
      "source": "auto"
    },
    {
      "action": "wait",
      "note": "Chờ ảnh tải lên xong",
