{
  "site": "ngochuyduong.com",
  "version": 1,
  "steps": [
    {
      "action": "type",
      "note": "AI tiêu đề → Tên sản phẩm",
      "selector": "h1.editor-post-title__input",
      "selectors": [
        "h1.editor-post-title__input",
        ".editor-post-title__input",
        "h1.wp-block-post-title",
        "[aria-label='Add title']",
        "[aria-label='Thêm tiêu đề']",
        "#title",
        "input[name='post_title']"
      ],
      "value": "{{title}}",
      "source": "auto"
    },
    {
      "action": "type",
      "note": "AI description → Mô tả ngắn sản phẩm",
      "selector": "textarea#excerpt",
      "selectors": [
        "textarea#excerpt",
        "#excerpt",
        "textarea[name='excerpt']",
        "[data-type='core/post-excerpt'] textarea",
        "[data-type*='product-summary'] textarea",
        "[data-type*='product-summary'] [contenteditable='true']",
        ".wp-block-post-excerpt__excerpt",
        "[aria-label*='mô tả ngắn' i]",
        "[aria-label*='short description' i]"
      ],
      "value": "{{description}}",
      "source": "auto",
      "optional": true
    },
    {
      "action": "click",
      "note": "Mở menu Tùy chọn (⋮)",
      "selector": "button[aria-label='Options']",
      "selectors": [
        "button[aria-label='Options']",
        "button[aria-label='Tùy chọn']",
        "button[aria-label*='Options']",
        "button[aria-label*='Tùy chọn']"
      ],
      "value": "",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Chọn “Code editor” (trình soạn thảo mã)",
      "selector": "button:has-text('Code editor')",
      "selectors": [
        "button:has-text('Code editor')",
        "[role='menuitem']:has-text('Code editor')",
        "button:has-text('Trình soạn thảo mã')",
        "[role='menuitem']:has-text('Trình soạn thảo mã')"
      ],
      "value": "",
      "source": "auto"
    },
    {
      "action": "type",
      "note": "AI content (HTML) → Mô tả sản phẩm",
      "selector": ".editor-post-text-editor",
      "selectors": [
        ".editor-post-text-editor",
        "textarea.editor-post-text-editor",
        ".block-editor-block-list__layout",
        "#content"
      ],
      "value": "{{content_html}}",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Mở menu Tùy chọn (đổi lại giao diện thường)",
      "selector": "button[aria-label='Options']",
      "selectors": [
        "button[aria-label='Options']",
        "button[aria-label='Tùy chọn']",
        "button[aria-label*='Options']",
        "button[aria-label*='Tùy chọn']"
      ],
      "value": "",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Chọn “Visual editor”",
      "selector": "button:has-text('Visual editor')",
      "selectors": [
        "button:has-text('Visual editor')",
        "[role='menuitem']:has-text('Visual editor')",
        "button:has-text('Trình soạn thảo trực quan')",
        "[role='menuitem']:has-text('Trình soạn thảo trực quan')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "wait",
      "note": "Chờ giao diện ổn định",
      "selector": "",
      "selectors": [],
      "value": "1.5",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Mở card Rank Math SEO (bên phải)",
      "selector": "button:has-text('Rank Math SEO')",
      "selectors": [
        "button:has-text('Rank Math SEO')",
        "[data-testid='rank-math-seo']",
        "#rank-math-seo-tab",
        ".components-panel__body button:has-text('Rank Math')",
        "button:has-text('Rank Math')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "type",
      "note": "AI focus keyword → Từ khoá chính (Rank Math)",
      "selector": "#rank-math-focus-keyword",
      "selectors": [
        "#rank-math-focus-keyword",
        "input[name='rank_math_focus_keyword']",
        "input[id*='focus-keyword']",
        "[data-testid='focus-keyword-input']",
        "input[placeholder*='focus keyword' i]",
        "input[placeholder*='từ khóa chính' i]",
        "input[placeholder*='từ khoá chính' i]"
      ],
      "value": "{{focus_keyword}}",
      "source": "auto",
      "optional": true
    },
    {
      "action": "click",
      "note": "AI hình 1 → bấm “Đặt ảnh sản phẩm”",
      "selector": "button:has-text('Đặt ảnh sản phẩm')",
      "selectors": [
        "button:has-text('Đặt ảnh sản phẩm')",
        "button:has-text('Set product image')",
        "#set-post-thumbnail",
        ".inside #set-post-thumbnail",
        ".woocommerce-product-images__actions button",
        "[aria-label*='Ảnh sản phẩm']",
        "[aria-label*='Product image']"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "click",
      "note": "Chuyển sang tab “Tải tệp lên”",
      "selector": "#menu-item-upload",
      "selectors": [
        "#menu-item-upload",
        ".media-menu-item:has-text('Tải tệp lên')",
        ".media-menu-item:has-text('Upload files')",
        "button:has-text('Tải tệp lên')",
        "button:has-text('Upload files')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "upload",
      "note": "Tải ảnh 1 lên",
      "selector": ".media-modal input[type='file']",
      "selectors": [
        ".media-modal input[type='file']",
        ".media-frame input[type='file']",
        "input[type='file']"
      ],
      "value": "{{image_1}}",
      "source": "auto"
    },
    {
      "action": "wait",
      "note": "Chờ ảnh tải lên xong",
      "selector": "",
      "selectors": [],
      "value": "4",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Chọn ảnh vừa tải (đầu tiên)",
      "selector": ".media-frame .attachment:first-child",
      "selectors": [
        ".media-frame .attachment:first-child",
        ".media-modal .attachment:first-child",
        ".attachments .attachment"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "click",
      "note": "Đặt làm ảnh sản phẩm",
      "selector": ".media-button-select",
      "selectors": [
        ".media-button-select",
        "button.media-button-select",
        ".media-toolbar-primary button",
        "button:has-text('Đặt ảnh sản phẩm')",
        "button:has-text('Set product image')",
        "button:has-text('Chọn')",
        "button:has-text('Select')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "wait",
      "note": "Chờ đóng hộp ảnh",
      "selector": "",
      "selectors": [],
      "value": "1.5",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Ảnh 2+ → bấm “Thêm vào thư viện ảnh sản phẩm”",
      "selector": "button:has-text('Thêm vào thư viện')",
      "selectors": [
        "button:has-text('Thêm vào thư viện')",
        "button:has-text('Add to gallery')",
        "button:has-text('Thêm ảnh')",
        "#add_image",
        ".woocommerce-product-gallery__actions button"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "click",
      "note": "Chuyển sang tab “Tải tệp lên” (thư viện)",
      "selector": "#menu-item-upload",
      "selectors": [
        "#menu-item-upload",
        ".media-menu-item:has-text('Tải tệp lên')",
        ".media-menu-item:has-text('Upload files')",
        "button:has-text('Tải tệp lên')",
        "button:has-text('Upload files')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    },
    {
      "action": "upload",
      "note": "Tải các ảnh còn lại lên (ảnh 2,3,4,5,6…)",
      "selector": ".media-modal input[type='file']",
      "selectors": [
        ".media-modal input[type='file']",
        ".media-frame input[type='file']",
        "input[type='file']"
      ],
      "value": "{{image_2}}|{{image_3}}|{{image_4}}|{{image_5}}|{{image_6}}",
      "source": "auto"
    },
    {
      "action": "wait",
      "note": "Chờ ảnh tải lên xong",
      "selector": "",
      "selectors": [],
      "value": "5",
      "source": "auto"
    },
    {
      "action": "click",
      "note": "Thêm vào thư viện ảnh sản phẩm",
      "selector": ".media-button-select",
      "selectors": [
        ".media-button-select",
        "button.media-button-select",
        ".media-toolbar-primary button",
        "button:has-text('Thêm vào thư viện')",
        "button:has-text('Add to gallery')",
        "button:has-text('Cập nhật thư viện')"
      ],
      "value": "",
      "source": "auto",
      "optional": true
    }
  ]
}
